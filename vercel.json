{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    { "source": "/hydro-jetting-bellevue-wa", "destination": "/services/drain-cleaning", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|videos/|projects/|images/|robots\\.txt|favicon\\.svg).*)",
      "destination": "/api/server"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(videos|projects|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
