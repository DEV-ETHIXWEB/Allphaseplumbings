{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    { "source": "/hydro-jetting-bellevue-wa", "destination": "/services/drain-cleaning", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/plumbing/water-heaters", "destination": "/services/water-heaters", "permanent": true },
    { "source": "/plumbing/hydro-jetting", "destination": "/services/drain-cleaning", "permanent": true },
    { "source": "/plumbing/drain-cleaning", "destination": "/services/drain-cleaning", "permanent": true },
    { "source": "/plumbing/water-filtration-system-installation", "destination": "/services/plumbing/water-filtration", "permanent": true },
    { "source": "/plumbing/:slug", "destination": "/services/plumbing/:slug", "permanent": true },
    { "source": "/plumbing", "destination": "/services/plumbing", "permanent": true },
    { "source": "/sewer", "destination": "/services/sewer-services", "permanent": true },
    { "source": "/commercial/commercial-drain-cleaning", "destination": "/commercial/drain-cleaning", "permanent": true },
    { "source": "/service-area/sammamish", "destination": "/service-area", "permanent": true },
    { "source": "/service-area/:city", "destination": "/areas/:city", "permanent": true },
    { "source": "/the-difference-between-a-handyman-and-a-professional-plumber-in-seattle", "destination": "/blog/handyman-vs-professional-plumber-seattle", "permanent": true },
    { "source": "/tankless-water-heaters-in-seattle-is-it-worth-the-upgrade/feed", "destination": "/blog/tankless-water-heaters-seattle-worth-upgrade", "permanent": true },
    { "source": "/tankless-water-heaters-in-seattle-is-it-worth-the-upgrade", "destination": "/blog/tankless-water-heaters-seattle-worth-upgrade", "permanent": true },
    { "source": "/the-2026-puget-sound-winter-plumbing-survival-guide-performance-prevention-and-technology", "destination": "/blog/puget-sound-winter-plumbing-survival-guide", "permanent": true },
    { "source": "/preventing-tree-root-damage-in-seattle-sewer-lines", "destination": "/blog/preventing-tree-root-damage-sewer-lines", "permanent": true },
    { "source": "/author/:name", "destination": "/blog", "permanent": true },
    { "source": "/plumber-auburn-wa", "destination": "/areas/auburn", "permanent": true },
    { "source": "/plumber-bellevue-wa", "destination": "/areas/bellevue", "permanent": true },
    { "source": "/plumber-bonney-lake-wa", "destination": "/areas/bonney-lake", "permanent": true },
    { "source": "/plumber-bothell-wa", "destination": "/areas/bothell", "permanent": true },
    { "source": "/plumber-des-moines-wa", "destination": "/areas/des-moines", "permanent": true },
    { "source": "/plumber-federal-way-wa", "destination": "/areas/federal-way", "permanent": true },
    { "source": "/plumber-fife-wa", "destination": "/areas/fife", "permanent": true },
    { "source": "/plumber-kent-wa", "destination": "/areas/kent", "permanent": true },
    { "source": "/plumber-kirkland-wa", "destination": "/areas/kirkland", "permanent": true },
    { "source": "/plumber-lakewood-wa", "destination": "/areas/lakewood", "permanent": true },
    { "source": "/plumber-mercer-island-wa", "destination": "/areas/mercer-island", "permanent": true },
    { "source": "/plumber-puyallup-wa", "destination": "/areas/puyallup", "permanent": true },
    { "source": "/plumber-redmond-wa", "destination": "/areas/redmond", "permanent": true },
    { "source": "/plumber-renton-wa", "destination": "/areas/renton", "permanent": true },
    { "source": "/plumber-seattle-wa", "destination": "/areas/seattle", "permanent": true },
    { "source": "/plumber-south-hill-wa", "destination": "/areas/south-hill", "permanent": true },
    { "source": "/plumber-spanaway-wa", "destination": "/areas/spanaway", "permanent": true },
    { "source": "/plumber-summit-wa", "destination": "/areas/summit", "permanent": true },
    { "source": "/plumber-summit-view-wa", "destination": "/areas/summit-view", "permanent": true },
    { "source": "/plumber-tacoma-wa", "destination": "/areas/tacoma", "permanent": true },
    { "source": "/plumber-tukwila-wa", "destination": "/areas/tukwila", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|videos/|projects/|images/|robots\\.txt|favicon\\.svg).*)",
      "destination": "/api/server"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(videos|projects|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
